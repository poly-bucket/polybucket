{
  "Database": {
    "Host": "127.0.0.1",
    "Port": 5432,
    "Name": "polybucket_test",
    "Username": "postgres",
    "Password": "postgres",
    "SslMode": "Disable",
    "EnsureDatabaseCreated": true,
    "MaintenanceDatabase": "postgres",
    "SkipHostDatabaseInitialization": true
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthStrict": { "PermitLimit": 100000, "WindowSeconds": 60 },
    "AuthStandard": { "PermitLimit": 100000, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": ["127.0.0.0/8", "10.0.0.0/8"],
    "ForwardLimit": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Storage": {
    "Endpoint": "localhost",
    "Port": 9000,
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "polybucket-test-uploads",
    "UseSSL": false
  },
  "Email": {
    "Dispatcher": {
      "Enabled": false
    }
  },
  "AppSettings": {
    "Security": {
      "JwtSecret": "test-jwt-secret-key-for-testing-purposes-only-32-chars",
      "JwtIssuer": "polybucket-test-api",
      "JwtAudience": "polybucket-test-client",
      "AccessTokenExpiryMinutes": 60,
      "RefreshTokenExpiryDays": 7,
      "MaxFailedAccessAttempts": 5,
      "LockoutDurationMinutes": 15
    },
    "Frontend": {
      "BaseUrl": "http://localhost:3001"
    },
    "Storage": {
      "BasePath": "test-uploads",
      "MaxFileSize": 1073741824,
      "AllowedExtensions": [".stl", ".obj", ".fbx", ".3ds", ".glb", ".gltf", ".ply", ".step", ".stp", ".iges", ".igs", ".brep", ".png", ".jpg", ".jpeg", ".gif"]
    }
  }
} 